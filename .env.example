# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: For server-side operations (not used in client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Analytics/Tracking
# EXPO_PUBLIC_GA_ID=G-XXXXXXXXXX
# EXPO_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# Optional: URL web produksi untuk tombol "Buka di browser" di aplikasi mobile
# EXPO_PUBLIC_SITE_URL=https://portofoliov2.ahmadrosyidalfualdi.workers.dev/

# --- Server-only: DeepL auto-translate (Edge Function) ---
# NEVER prefix with EXPO_PUBLIC_ — this key must never reach the client.
# Free-tier key ends with `:fx` and uses https://api-free.deepl.com
# (Pro keys use https://api.deepl.com). Free quota ~500k chars/month.
# The Edge Function reads it from Supabase secrets, NOT from this file.
# DEEPL_AUTH_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
# Setup (run once, then redeploy on key change):
#   supabase secrets set DEEPL_AUTH_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
#   supabase functions deploy translate
