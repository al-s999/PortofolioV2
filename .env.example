# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: For server-side operations (not used in client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Analytics/Tracking
# EXPO_PUBLIC_GA_ID=G-XXXXXXXXXX
# EXPO_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# Optional: URL web produksi untuk tombol "Buka di browser" di aplikasi mobile
# EXPO_PUBLIC_SITE_URL=https://portofoliov2.ahmadrosyidalfualdi.workers.dev/
